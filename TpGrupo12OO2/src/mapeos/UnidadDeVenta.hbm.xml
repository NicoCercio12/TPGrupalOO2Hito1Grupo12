<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="datos.UnidadDeVenta" table="UnidadDeVenta">
		<id column="id" name="idUnidad">
			<generator class="identity" />
		</id>
		<property column="nombreComercial" name="nombreComercial" type="string" />
		<property column="codUnico" name="codUnico" type="string" />
		<property column="costo" name="costo" type="double" />
		<property column="superficie" name="superficie" type="double" />

		<!-- RELACIÓN CON EMPLEADO RESPONSABLE -->
		<many-to-one name="responsable" class="datos.Empleado" column="idResponsable" not-null="false" />

		<!-- MUCHOS A MUCHOS CON PLATO (name coincide con lstPlatos) -->
		<set table="platosxunidad" name="lstPlatos" outer-join="true" lazy="true">
			<key column="idUnidad"/>
			<many-to-many column="idPlato" class="datos.Plato"/>
		</set>
		
		<!-- UNO A MUCHOS CON PEDIDO (name coincide con lstPedidos) -->
		<set name="lstPedidos" table="pedido" order-by="idPedido asc" inverse="true" lazy="true" fetch="select">
			<key column="idUnidad" not-null="true" />
			<one-to-many class="datos.Pedido" />
		</set>
		
		<!-- UNO A MUCHOS CON STAFF (name coincide con lstStaff) -->
		<set name="lstStaff" table="empleado" inverse="true" lazy="true">
			<key column="idUnidad" />
			<one-to-many class="datos.Empleado" />
		</set> 

		<!-- SUBCLASE PuestoDesarmable -->
		<joined-subclass name="datos.PuestoDesarmable" table="puestoDesarmable">
			<key column="idPuesto" />
			<property column="cantCarpas" name="cantidadCarpas" type="int" />
			<property column="tiempoMontajesMinutos" name="tiempoMontajeMinutos" type="int" />
		</joined-subclass>

		<!-- SUBCLASE FoodTruck -->
		<joined-subclass name="datos.FoodTruck" table="foodTruck">
			<key column="idFoodTruck" />
			<property column="patente" name="patente" type="string" />
			<property column="usaElectricidad" name="usaElectricidad" type="boolean" />
		</joined-subclass>

	</class>
</hibernate-mapping>