<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Festival" table="festival">
        <id column="idFestival" name="idFestival">
            <generator class="identity"/>
        </id>

        <property column="nombre" name="nombre" type="string"/>
        <property column="temporada" name="temporada" type="string"/>
        <property column="fechaInicio" name="fechaInicio" type="java.time.LocalDate"/>
        <property column="fechaFin" name="fechaFin" type="java.time.LocalDate"/>

        <!-- Relación con Pedido -->
<!--        <set name="pedidos" table="pedido" inverse="true" cascade="all">-->
<!--            <key column="idFestival"/>-->
<!--            <one-to-many class="datos.Pedido"/>-->
<!--        </set>-->
    </class>
</hibernate-mapping>
