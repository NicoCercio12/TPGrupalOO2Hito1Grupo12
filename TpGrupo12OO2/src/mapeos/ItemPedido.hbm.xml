<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.ItemPedido" table="item_pedido">

        <!-- Clave primaria -->
        <id name="idItemPedido" column="idItemPedido" type="long">
            <generator class="identity"/>
        </id>

        <!-- Relación con Plato -->
        <many-to-one name="plato" class="datos.Plato" column="idPlato" not-null="true"/>

        <!-- Cantidad -->
        <property name="cantidad" column="cantidad" type="int" not-null="true"/>

    </class>
</hibernate-mapping>
