<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<!-- Agregado: abstract="true" -->
	<class name="datos.Empleado" table="empleado" abstract="true">
		<!-- Verificá si la PK en MySQL es 'id' o 'idEmpleado' -->
		<id column="idEmpleado" name="idEmpleado">
			<generator class="identity" />
		</id>

		<property column="nombre" name="nombre" type="string" />
		<property column="apellido" name="apellido" type="string" />
		<property column="dni" name="dni" type="string" unique="true" />
		<property column="fechaNacimiento" name="fechaNacimiento" type="java.time.LocalDate" />
		<property column="fechaIngreso" name="fechaIngreso" type="java.time.LocalDate" />
		<property column="sueldoBase" name="sueldoBase" type="double" />

		<!-- Subclase Cocinero -->
		<joined-subclass name="datos.Cocinero" table="cocinero">
			<key column="idEmpleado" />
			<property column="especialidadCulinaria" name="especialidadCulinaria" type="string" />
			<property column="plusCategoria" name="plusCategoria" type="double" />
		</joined-subclass>

		<!-- Subclase Cajero -->
		<joined-subclass name="datos.Cajero" table="cajero">
			<key column="idEmpleado" />
			<property column="turno" name="turno" type="string" />
		</joined-subclass>

	</class>
</hibernate-mapping>